<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(CoreVersion);$(CoreVersion)-android</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenAL.Extensions.Enumeration" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenAL.Extensions.Soft" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsAndroid)' == 'false'">
		<Content Include="$(NativeLibsDir)openal\win-x64\*.dll"
				 CopyToOutputDirectory="PreserveNewest"
				 UseLink="True"
			     Visible="False"
				 Link="%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsAndroid)' == 'true'">
		<AndroidNativeLibrary Abi="arm64-v8a" Include="$(NativeLibsDir)openal\android-arm64\*.*" />
	</ItemGroup>
</Project>
