{
  "compilerOptions": {
    "noImplicitAny": false,
    "noEmitOnError": false,
    "sourceMap": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist/types",
    "declaration": true,

    "inlineSources": false,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true
  },
  "compileOnSave": true,
  "include": [
    "src/"
  ]
}