<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>XrEditor</RootNamespace>
		<OutputType>WinExe</OutputType>
		<AssemblyName>XrEditor</AssemblyName>
		<TargetFrameworks>$(CoreVersion)-$(WinVersion)</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<XamlDebuggingInformation>True</XamlDebuggingInformation>
		<RuntimeIdentifier>win-$(NativePlatform)</RuntimeIdentifier>
		<UseOpenGL>true</UseOpenGL>
		<ApplicationIcon>XrEditor.ico</ApplicationIcon>
		<NoWarn>MC3066</NoWarn>

	</PropertyGroup>

	<ItemGroup>
	  <Resource Include="XrEditor.ico" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Fluent.Ribbon" Version="11.0.2" />
	  <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
	  <PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
	  <PackageReference Include="WPF-Icons" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Engine\XrEngine.Filament.Wpf\XrEngine.Filament.Wpf.csproj" />
	  <ProjectReference Include="..\..\Engine\XrEngine.Media.FFmpeg\XrEngine.Media.FFmpeg.csproj" />
	  <ProjectReference Include="..\..\Engine\XrEngine.OpenGL.Wpf\XrEngine.OpenGL.Wpf.csproj" />
	  <ProjectReference Include="..\..\Framework\OpenXr.Framework.OpenGL\OpenXr.Framework.OpenGL.csproj" />
	  <ProjectReference Include="..\..\UI\UI.Canvas.Wpf\UI.Canvas.Wpf.csproj" />
	  <ProjectReference Include="..\XrEditor.Audio\XrEditor.Audio.csproj" />
	  <ProjectReference Include="..\XrEditor.Plot\XrEditor.Plot.csproj" />
	  <ProjectReference Include="..\XrEditor.Core\XrEditor.Core.csproj" />
	</ItemGroup>


	<ItemGroup>
	  <None Update="alsoft.ini">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>

	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(DefineConstants)').Contains('GL_WRAPPER'))">
		<Using Include="OpenGLWrapper.IGLWrapper" Alias="GL" />
		<Using Include="OpenGLWrapper" />
	</ItemGroup>

</Project>
