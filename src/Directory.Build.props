<?xml version="1.0" encoding="utf-8"?>

<Project>

	<PropertyGroup>
		<CoreVersion>net11.0</CoreVersion>
		<WinVersion>windows10.0.26100.0</WinVersion>
		<TargetFrameworks>$(CoreVersion)</TargetFrameworks>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageVersion>0.2.1</PackageVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64</Platforms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);CS8500</NoWarn>
		<Configurations>Debug;Release</Configurations>
		<OpenGL></OpenGL>
		<AndroidPlatform>30</AndroidPlatform>
		<IsAndroid>false</IsAndroid>
		<NativeFolder>$(Configuration)</NativeFolder>
		<NativePlatform>x64</NativePlatform>
		<NativeLibsDir>$(SolutionDir)..\libs\</NativeLibsDir>
		<FilamentLink>PreBuilt</FilamentLink>
		<AndroidNativeOutDir>$(ProjectDir)libs\arm64-v8a\</AndroidNativeOutDir>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		<UseMonoRuntime>false</UseMonoRuntime>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DiagnosticOn)' == 'True'">
		<DiagnosticPort>9100</DiagnosticPort>
		<DiagnosticAddress>127.0.0.1</DiagnosticAddress>
		<DiagnosticSuspend>false</DiagnosticSuspend>
		<DiagnosticListenMode>connect</DiagnosticListenMode>
		<EnableDiagnostics>true</EnableDiagnostics>
		<AndroidManagedSymbols>true</AndroidManagedSymbols>
		<StripSymbols>false</StripSymbols>
		<EmbedAllSources>true</EmbedAllSources>
		<EnableLLVM>false</EnableLLVM>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Optmize>false</Optmize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<IsTrimmable>false</IsTrimmable>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(TargetFramework)' == '$(CoreVersion)-android'">
		<OpenGL>ES</OpenGL>
		<IsAndroid>true</IsAndroid>
	</PropertyGroup>

	<PropertyGroup Condition="'$(OpenGL)' == 'ES'">
		<DefineConstants>$(DefineConstants);GLES</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<_ProjectReferenceNames Include="@(ProjectReference->'%(Filename)')" />
	</ItemGroup>

	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(MSBuildProjectName)' != 'XrEngine.Generator'">
		<ProjectReference Include="$(SolutionDir)\Engine\XrEngine.Generator\XrEngine.Generator.csproj"
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AndroidBuildOutput Include="$(AndroidNativeOutDir)*.so" />
	</ItemGroup>

	<Target
		Name="RunAndroidBuildScript"
		BeforeTargets="Build"
		Condition="Exists('$(ProjectDir)android-build.cmd')"
		Inputs="
			@(ClCompile);
			@(ClInclude);
			$(ProjectDir)android-build.cmd;
			$(ProjectDir)Android.mk;
			$(ProjectDir)Application.mk;
			$(SolutionDir)..\third-party\vars.cmd" 
		Outputs="@(AndroidBuildOutput)">

		<Exec
			Command="call &quot;$(ProjectDir)android-build.cmd&quot;"
			WorkingDirectory="$(ProjectDir)" />
	</Target>
</Project>
