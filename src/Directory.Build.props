<?xml version="1.0" encoding="utf-8"?>

<Project>

	<PropertyGroup>
		<CoreVersion>net11.0</CoreVersion>
		<WinVersion>windows10.0.26100.0</WinVersion>
		<TargetFrameworks>$(CoreVersion)</TargetFrameworks>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageVersion>0.3.0</PackageVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64</Platforms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);CS8500</NoWarn>
		<Configurations>Debug;Release</Configurations>
		<OpenGL></OpenGL>
		<AndroidPlatform>30</AndroidPlatform>
		<IsAndroid>false</IsAndroid>
		<!-- Runtime ABI selector: 141 keeps the legacy binaries; 590 selects the PhysX 5.9 binaries. -->
		<PhysXRuntimeVersion Condition="'$(PhysXRuntimeVersion)' == ''">141</PhysXRuntimeVersion>
		<NativeFolder>$(Configuration)</NativeFolder>
		<NativePlatform>x64</NativePlatform>
		<NativeLibsDir>$(SolutionDir)..\libs\</NativeLibsDir>
		<FilamentLink>PreBuilt</FilamentLink>
		<AndroidNativeOutDir>$(ProjectDir)libs\arm64-v8a\</AndroidNativeOutDir>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		<UseMonoRuntime>false</UseMonoRuntime>
		<MsExtVersion>$(BundledNETCoreAppPackageVersion)</MsExtVersion>
		<UseAngle>false</UseAngle>
	    <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
		<CreateSymbolicLinksForCopyLocalIfPossible>false</CreateSymbolicLinksForCopyLocalIfPossible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(PhysXRuntimeVersion)' == '590'">
		<NativeFolder>$(Configuration)-590</NativeFolder>
		<PhysXLibFolder>physx-590\bin\win-x64\release</PhysXLibFolder>
	</PropertyGroup>
	<PropertyGroup Condition="'$(PhysXRuntimeVersion)' != '590'">
		<PhysXLibFolder>physx-141\bin\win-x64\mt\release</PhysXLibFolder>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseAngle)' == 'true'">
		<OpenGL>ES</OpenGL>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == '$(CoreVersion)-android'">
		<OpenGL>ES</OpenGL>
		<IsAndroid>true</IsAndroid>
	</PropertyGroup>

	<PropertyGroup Condition="'$(OpenGL)' == 'ES'">
		<DefineConstants>$(DefineConstants);GLES</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<_ProjectReferenceNames Include="@(ProjectReference->'%(Filename)')" />
	</ItemGroup>

	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(MSBuildProjectName)' != 'XrEngine.Generator'">
		<ProjectReference Include="$(SolutionDir)\Engine\XrEngine.Generator\XrEngine.Generator.csproj"
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AndroidBuildOutput Include="$(AndroidNativeOutDir)*.so" />
	</ItemGroup>


	<Target Name="PropagateUseLink"
		Condition="'$(CreateHardLinksForCopyLocalIfPossible)' == 'true'"
        AfterTargets="GetCopyToOutputDirectoryItems">

		<ItemGroup>
			<_LinkContent Include="@(Content)"
						  Condition="'%(Content.UseLink)' == 'true'">
				<SourcePath>%(Content.FullPath)</SourcePath>
			</_LinkContent>

			<_ReturnedLinkItems Include="@(AllItemsFullPathWithTargetPath)">
				<SourcePath>%(AllItemsFullPathWithTargetPath.FullPath)</SourcePath>
			</_ReturnedLinkItems>

			<_ReturnedNonLinkItems Include="@(_ReturnedLinkItems)" />

			<_ReturnedNonLinkItems
				Remove="@(_LinkContent)"
				MatchOnMetadata="SourcePath"
				MatchOnMetadataOptions="PathLike" />

			<_ReturnedLinkItems
				Remove="@(_ReturnedNonLinkItems)"
				MatchOnMetadata="SourcePath"
				MatchOnMetadataOptions="PathLike" />

			<AllItemsFullPathWithTargetPath
				Update="@(_ReturnedLinkItems)"
				MatchOnMetadata="FullPath"
				MatchOnMetadataOptions="PathLike">
				<UseLink>true</UseLink>
			</AllItemsFullPathWithTargetPath>
		</ItemGroup>

	</Target>

	<Target Name="PrepareNativeLibraryLinks"
			Condition="'$(CreateHardLinksForCopyLocalIfPossible)' == 'true'"
			BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory">

		<ItemGroup>
			<!-- Final propagated items that are marked for linking -->
			<_PropagatedLinkItems Include="@(AllItemsFullPathWithTargetPath)"
								  Condition="'%(AllItemsFullPathWithTargetPath.UseLink)' == 'true'">
				<SourcePath>%(AllItemsFullPathWithTargetPath.FullPath)</SourcePath>
			</_PropagatedLinkItems>

			<!-- Start from the actual final copy list -->
			<_NativeLibrariesToLink Include="@(_SourceItemsToCopyToOutputDirectory)">
				<SourcePath>%(_SourceItemsToCopyToOutputDirectory.FullPath)</SourcePath>
			</_NativeLibrariesToLink>

			<_NonLinkItems Include="@(_NativeLibrariesToLink)" />

			<!-- Remove everything that matches a propagated link item -->
			<_NonLinkItems
				Remove="@(_PropagatedLinkItems)"
				MatchOnMetadata="SourcePath"
				MatchOnMetadataOptions="PathLike" />

			<!-- Keep only the matching link items -->
			<_NativeLibrariesToLink
				Remove="@(_NonLinkItems)"
				MatchOnMetadata="SourcePath"
				MatchOnMetadataOptions="PathLike" />

			<!-- Add SourcePath to the real source list so removal matches reliably -->
			<_SourceItemsToCopyToOutputDirectory Update="@(_SourceItemsToCopyToOutputDirectory)">
				<SourcePath>%(_SourceItemsToCopyToOutputDirectory.FullPath)</SourcePath>
			</_SourceItemsToCopyToOutputDirectory>

			<!-- Remove linked items from the normal copy pipeline -->
			<_SourceItemsToCopyToOutputDirectory
				Remove="@(_NativeLibrariesToLink)"
				MatchOnMetadata="SourcePath"
				MatchOnMetadataOptions="PathLike" />
		</ItemGroup>

		<Copy
			SourceFiles="@(_NativeLibrariesToLink)"
			DestinationFiles="@(_NativeLibrariesToLink->'$(OutDir)%(TargetPath)')"
			SkipUnchangedFiles="true"
			UseHardlinksIfPossible="true">

			<Output TaskParameter="DestinationFiles"
					ItemName="FileWrites" />
		</Copy>

	</Target>

	<Target
		Name="RunAndroidBuildScript"
		BeforeTargets="Build"
		Condition="Exists('$(ProjectDir)android-build.cmd')"
		Inputs="
			@(ClCompile->'%(FullPath)');
			@(ClInclude->'%(FullPath)');
			$(ProjectDir)android-build.cmd;
			$(ProjectDir)Android.mk;
			$(ProjectDir)Application.mk;
			$(SolutionDir)..\third-party\vars.cmd"
		Outputs="$(IntDir)android-build.stamp">

		<Exec
			Command="call &quot;$(ProjectDir)android-build.cmd&quot;"
			WorkingDirectory="$(ProjectDir)" />

		<Touch Files="$(IntDir)android-build.stamp" AlwaysCreate="true" />
	</Target>



</Project>
