<Project Sdk="Microsoft.NET.Sdk">


	<PropertyGroup>
		<TargetFrameworks/>
		<TargetFramework>$(CoreVersion)-android</TargetFramework>
		<SupportedOSPlatformVersion>$(AndroidPlatform)</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<ApplicationId>net.eusoft.oculus</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<UseOpenGL>true</UseOpenGL>
		<DiagnosticOn>false</DiagnosticOn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DiagnosticOn)' == 'True'">
		<DiagnosticPort>9100</DiagnosticPort>
		<DiagnosticAddress>127.0.0.1</DiagnosticAddress>
		<DiagnosticSuspend>false</DiagnosticSuspend>
		<DiagnosticListenMode>connect</DiagnosticListenMode>
		<EnableDiagnostics>true</EnableDiagnostics>
		<AndroidManagedSymbols>true</AndroidManagedSymbols>
		<AndroidStripNativeLibraries>false</AndroidStripNativeLibraries>
		<StripSymbols>false</StripSymbols>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<Target Name="InvalidateJavaCompile"
			BeforeTargets="_CompileJava">
		<Delete Files="$(IntermediateOutputPath)stamp\_CompileJava.stamp"
				Condition="Exists('$(IntermediateOutputPath)stamp\_CompileJava.stamp')" />
	</Target>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
		<AndroidStripNativeLibraries>false</AndroidStripNativeLibraries>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishTrimmed>false</PublishTrimmed>
		<EnableLLVM>false</EnableLLVM>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='_Release'">
		<PublishTrimmed>true</PublishTrimmed>
		<EnableLLVM>false</EnableLLVM>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>
		<AndroidNativeLibrary Abi="arm64-v8a" Include="../../../libs/*.so" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Engine\XrEngine.Filament\XrEngine.Filament.csproj" />
		<ProjectReference Include="..\..\Engine\XrEngine.Media.Android\XrEngine.Media.Android.csproj" />
		<ProjectReference Include="..\..\Engine\XrEngine.OpenXr.Android\XrEngine.OpenXr.Android.csproj" />
		<ProjectReference Include="..\..\Framework\OpenXr.Framework.Android\OpenXr.Framework.Android.csproj" />
		<ProjectReference Include="..\XrSamples.Common\XrSamples.Common.csproj" />
		<ProjectReference Include="..\..\WebLink\XrWebLink.Android\XrWebLink.Android.csproj" />
		<ProjectReference Include="..\XrSamples.Dnd\XrSamples.Dnd.csproj" />
		<ProjectReference Include="..\XrSamples.Graffiti\XrSamples.Graffiti.csproj" />
	</ItemGroup>

	<Import Project="..\..\AspNetCoreMini.props" />

</Project>