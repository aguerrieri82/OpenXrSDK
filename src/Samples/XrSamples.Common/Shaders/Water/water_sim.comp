layout(local_size_x = 8, local_size_y = 8) in;

// RG: primary height and velocity. BA: persistent high-frequency height and velocity.
// The two array layers are the ping-pong states.
layout(rgba16f, binding = 0) readonly uniform highp image2DArray uWaterStateIn;
layout(rgba16f, binding = 1) writeonly uniform highp image2DArray uWaterStateOut;

uniform int uReadLayer;
uniform int uWriteLayer;
uniform float uDeltaTime;
uniform float uTime;
uniform float uWaveSpeed;
uniform float uDamping;
uniform float uRippleStrength;
uniform vec2 uPlayerUv;
uniform vec2 uPlayerDirection;
uniform vec2 uPlayerRadiusUv;
uniform float uPlayerImpulse;
uniform float uPlayerStrength;
uniform float uHighFrequencyStrength;
uniform float uHighFrequencyDamping;

vec4 loadState(ivec2 pixel, ivec2 size)
{
    return imageLoad(uWaterStateIn, ivec3(clamp(pixel, ivec2(0), size - ivec2(1)), uReadLayer));
}

float hash11(float value)
{
    return fract(sin(value * 127.1) * 43758.5453);
}

float impactRipple(vec2 uv, float period, float offset, float seed)
{
    float clock = uTime + offset;
    float cycle = floor(clock / period);
    float age = clock - cycle * period;

    vec2 center = vec2(hash11(cycle + seed), hash11(cycle + seed + 19.19));
    center = mix(vec2(0.12), vec2(0.88), center);

    // A brief, compact displacement creates a travelling circular wave.
    // Continuous forcing here produces the stationary dents used previously.
    float temporalPulse = exp(-pow(age / 0.035, 2.0));
    vec2 delta = uv - center;
    float spatialPulse = exp(-dot(delta, delta) / (0.012 * 0.012));

    return temporalPulse * spatialPulse;
}

float playerWake(vec2 uv)
{
    vec2 delta = (uv - uPlayerUv) / max(uPlayerRadiusUv, vec2(0.0001));
    float radius2 = dot(delta, delta);
    float longitudinalOffset = dot(delta, uPlayerDirection);
    return longitudinalOffset * exp(-radius2) * uPlayerImpulse;
}

void main()
{
    ivec2 size = imageSize(uWaterStateIn).xy;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(pixel, size)))
        return;

    vec4 state = loadState(pixel, size);
    float height = state.r;
    float velocity = state.g;
    float highHeight = state.b;
    float highVelocity = state.a;

    vec4 left = loadState(pixel + ivec2(-1, 0), size);
    vec4 right = loadState(pixel + ivec2(1, 0), size);
    vec4 down = loadState(pixel + ivec2(0, -1), size);
    vec4 up = loadState(pixel + ivec2(0, 1), size);
    float laplacian = left.r + right.r + down.r + up.r - 4.0 * height;
    float highLaplacian = left.b + right.b + down.b + up.b - 4.0 * highHeight;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    float source = impactRipple(uv, 1.7, 0.0, 3.7) + impactRipple(uv, 2.3, 0.9, 41.3) * 0.65;

    velocity += laplacian * uWaveSpeed * uDeltaTime;
    velocity += source * uRippleStrength * uDeltaTime * 30.0;
    velocity += playerWake(uv) * uPlayerStrength;
    velocity *= pow(uDamping, uDeltaTime * 60.0);
    height += velocity * uDeltaTime;

    highVelocity += highLaplacian * uWaveSpeed * 0.4 * uDeltaTime;
    highVelocity += source * uRippleStrength * uHighFrequencyStrength * uDeltaTime * 30.0;
    highVelocity += playerWake(uv) * uPlayerStrength * uHighFrequencyStrength;
    highVelocity *= pow(uHighFrequencyDamping, uDeltaTime * 60.0);
    highHeight += highVelocity * uDeltaTime;

    imageStore(uWaterStateOut, ivec3(pixel, uWriteLayer), vec4(height, velocity, highHeight, highVelocity));
}
