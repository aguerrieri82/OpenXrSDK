#include "./uniforms_comp.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly  uniform highp image2D uPaintIn;
layout(rgba16f, binding = 1) writeonly uniform highp image2D uPaintOut;

const float CENTER_DRIP_WEIGHT = 0.70;
const float SIDE_DRIP_WEIGHT   = 0.15;

bool Inside(ivec2 p)
{
    return
        p.x >= 0 &&
        p.y >= 0 &&
        p.x < CanvasSize.x &&
        p.y < CanvasSize.y;
}

ivec2 GetForwardStep(vec2 g)
{
    // Use dominant axis to avoid diagonal stair-step artifacts.
    if (abs(g.x) > abs(g.y))
        return ivec2(g.x > 0.0 ? 1 : -1, 0);

    return ivec2(0, g.y > 0.0 ? 1 : -1);
}

ivec2 GetSideStep(ivec2 forward)
{
    return ivec2(-forward.y, forward.x);
}

vec4 ComputeWetOutflow(vec4 wetPaint)
{
    float density = wetPaint.a;

    if (density <= EPS)
        return vec4(0.0);

    // Density-driven drip.
    // Low density naturally moves very little.
    float moveDensity =
        density *
        density *
        WetDripRate *
        GravityStrength *
        DeltaTime;

    moveDensity = clamp(moveDensity, 0.0, density);

    float f = moveDensity / density;

    return wetPaint * f;
}

vec4 IncomingFromSource(ivec2 source, float weight)
{
    if (!Inside(source))
        return vec4(0.0);

    vec4 srcWet = imageLoad(uPaintIn, source);
    return ComputeWetOutflow(srcWet) * weight;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (!Inside(p))
        return;

    vec4 wet = imageLoad(uPaintIn, p);
    vec4 resultWet = wet;

    vec2 g = GravityCanvas;

    if (length(g) > EPS && GravityStrength > 0.0 && WetDripRate > 0.0)
    {
        ivec2 forward = GetForwardStep(g);
        ivec2 side    = GetSideStep(forward);

        vec4 selfOutflow = ComputeWetOutflow(wet);

        // ---------------------------------------------------------------------
        // Subtract only the amount that actually leaves this texel.
        // Near texture borders, invalid destinations do not receive paint,
        // so they should not be subtracted either.
        // ---------------------------------------------------------------------

        float outgoingWeight = 0.0;

        if (Inside(p + forward))
            outgoingWeight += CENTER_DRIP_WEIGHT;

        if (Inside(p + forward + side))
            outgoingWeight += SIDE_DRIP_WEIGHT;

        if (Inside(p + forward - side))
            outgoingWeight += SIDE_DRIP_WEIGHT;

        resultWet -= selfOutflow * outgoingWeight;

        // ---------------------------------------------------------------------
        // Gather incoming paint from upstream sources.
        //
        // A source S contributes to current pixel P if:
        //
        //   S + forward        == P
        //   S + forward + side == P
        //   S + forward - side == P
        //
        // Therefore:
        //
        //   S = P - forward
        //   S = P - forward - side
        //   S = P - forward + side
        // ---------------------------------------------------------------------

        resultWet += IncomingFromSource(
            p - forward,
            CENTER_DRIP_WEIGHT
        );

        resultWet += IncomingFromSource(
            p - forward - side,
            SIDE_DRIP_WEIGHT
        );

        resultWet += IncomingFromSource(
            p - forward + side,
            SIDE_DRIP_WEIGHT
        );
    }

    imageStore(
        uPaintOut,
        p,
        max(resultWet, vec4(0.0))
    );
}