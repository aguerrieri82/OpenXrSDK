#include "./uniforms_comp.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly  uniform highp image2D uPaintIn;
layout(rgba16f, binding = 1) writeonly uniform highp image2D uPaintOut;

bool Inside(ivec2 p)
{
    return
        p.x >= 0 &&
        p.y >= 0 &&
        p.x < CanvasSize.x &&
        p.y < CanvasSize.y;
}

vec4 ComputeWetOutflow(vec4 wetPaint)
{
    float density = wetPaint.a;

    if (density <= EPS)
        return vec4(0.0);

    float excess = max(density - WetDripThreshold, 0.0);

    if (excess <= 0.0)
        return vec4(0.0);

    float moveDensity =
        excess *
        WetDripRate *
        GravityStrength *
        DeltaTime;

    moveDensity = clamp(moveDensity, 0.0, density);

    float f = moveDensity / density;

    return wetPaint * f;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (!Inside(p))
        return;

    vec4 wet = imageLoad(uPaintIn, p);
    vec4 resultWet = wet;

    vec2 g = GravityCanvas;

    if (length(g) > EPS && GravityStrength > 0.0)
    {
        ivec2 dripStep = ivec2(round(normalize(g)));

        if (dripStep != ivec2(0))
        {
            ivec2 upstream   = p - dripStep;
            ivec2 downstream = p + dripStep;

            if (Inside(downstream))
            {
                vec4 selfOutflow = ComputeWetOutflow(wet);
                resultWet -= selfOutflow;
            }

            if (Inside(upstream))
            {
                vec4 upstreamWet = imageLoad(
                    uPaintIn,
                    upstream
                );

                vec4 incoming = ComputeWetOutflow(upstreamWet);
                resultWet += incoming;
            }
        }
    }

    imageStore(
        uPaintOut,
        p,
        max(resultWet, vec4(0.0))
    );
}