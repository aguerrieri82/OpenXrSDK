#include "./uniforms_comp.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly uniform highp image2DArray uPaintLayers;

layout(rgba16f, binding = 1) writeonly uniform highp image2D uResolvedColor;
layout(rgba16f, binding = 2) writeonly uniform highp image2D uResolvedRoughness;
layout(rgba16f, binding = 3) writeonly uniform highp image2D uResolvedNormal;

float TotalDensityAt(ivec2 p, ivec2 size)
{
    p = clamp(p, ivec2(0), size - ivec2(1));

    float density = 0.0;

    for (int i = 0; i < MAX_PAINT_LAYERS; ++i)
    {
        if (i >= LayerCount)
            break;

        density += imageLoad(uPaintLayers, ivec3(p, i)).a;
    }

    return density;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec3 size3 = imageSize(uPaintLayers);
    ivec2 size = size3.xy;

    if (p.x >= size.x || p.y >= size.y)
        return;

    /*
        Layer 0 = wettest / newest / visually topmost.
        Higher layers = progressively drier / older / underneath.
    */

    vec3 resolvedColor = vec3(0.0);
    float resolvedWetness = 0.0;

    float remainingVisibility = 1.0;
    float resolvedAlpha = 0.0;

    for (int i = 0; i < MAX_PAINT_LAYERS; ++i)
    {
        if (i >= LayerCount)
            break;

        vec4 layer = imageLoad(uPaintLayers, ivec3(p, i));

        float layerDensity = layer.a;

        if (layerDensity <= 0.000001)
            continue;

        float layerCoverage = clamp(layerDensity, 0.0, 1.0);

        vec3 layerColor = layer.rgb / layerDensity;

        float contribution = remainingVisibility * layerCoverage;

        resolvedColor += layerColor * contribution;
        resolvedWetness += Layers[i].Wetness * contribution;

        resolvedAlpha += contribution;

        remainingVisibility *= 1.0 - layerCoverage;

        if (remainingVisibility <= 0.000001)
            break;
    }

    if (resolvedAlpha > 0.000001)
    {
        resolvedColor /= resolvedAlpha;
        resolvedWetness /= resolvedAlpha;
    }

    resolvedAlpha = clamp(resolvedAlpha, 0.0, 1.0);
    resolvedWetness = clamp(resolvedWetness, 0.0, 1.0);

    imageStore(
        uResolvedColor,
        p,
        vec4(resolvedColor, resolvedAlpha));

    float roughness =
        mix(uDryRoughness, uWetRoughness, resolvedWetness);

    /*
        glTF metallic-roughness packing:
        R = unused
        G = roughness
        B = metallic
        A = unused
    */
    imageStore(
        uResolvedRoughness,
        p,
        vec4(1.0, roughness, 0.0, 1.0));

    /*
        Normal is based on total paint thickness, not visible layer only.
    */
    float hL = TotalDensityAt(p + ivec2(-1,  0), size) * uDensityToHeight;
    float hR = TotalDensityAt(p + ivec2( 1,  0), size) * uDensityToHeight;
    float hD = TotalDensityAt(p + ivec2( 0, -1), size) * uDensityToHeight;
    float hU = TotalDensityAt(p + ivec2( 0,  1), size) * uDensityToHeight;

    vec3 n = normalize(vec3(
        -(hR - hL) * uHeightScale,
        -(hU - hD) * uHeightScale,
         1.0));

    vec3 encodedNormal = n * 0.5 + 0.5;

    imageStore(
        uResolvedNormal,
        p,
        vec4(encodedNormal, 1.0));
}