#include "./uniforms_comp.glsl"

layout(local_size_x = 8, local_size_y = 8) in;


// New model:
//
// uDryPaint:
//   rgb = visible / resolved paint color
//   a   = deposited visible paint density
//
// uWetPaint:
//   rgb = wetColor * wetDensity
//   a   = wetDensity
//


layout(rgba16f, binding = 0) readonly uniform highp image2D uWetPaint;
layout(rgba16f, binding = 1) readonly uniform highp image2D uDryPaint;


// Base color texture.
// rgb = straight base color
// a   = coverage
layout(rgba16f, binding = 3) writeonly uniform highp image2D uResolvedColor;

// PBR ORM-like texture.
// r = unused / fixed 1.0
// g = roughness
// b = metallic
// a = coverage
layout(rgba16f, binding = 4) writeonly uniform highp image2D uResolvedRoughness;

// Normal map.
// rgb = encoded tangent-space normal
// a   = coverage
layout(rgba16f, binding = 5) writeonly uniform highp image2D uResolvedNormal;


float VisibleCoverageFromDensity(float d)
{
    // Visible opacity comes only from dry/visible density.
    // Do not clamp before exp(), otherwise density > 1 stops mattering.
    return 1.0 - exp(-max(d, 0.0) * PaintOpacityScale);
}


float WetFactorFromDensity(float d)
{
    // Wet is not extra visible material.
    // It is only a state factor for roughness/gloss/mobility.
    return clamp(d, 0.0, 1.0);
}


float VisibleDensityAt(ivec2 p)
{
    p = clamp(p, ivec2(0), CanvasSize - ivec2(1));

    vec4 dry = imageLoad(uDryPaint, p);

    return max(dry.a, 0.0);
}


vec3 ResolveNormal(ivec2 p)
{
    float hL = VisibleDensityAt(p + ivec2(-1,  0));
    float hR = VisibleDensityAt(p + ivec2( 1,  0));
    float hD = VisibleDensityAt(p + ivec2( 0, -1));
    float hU = VisibleDensityAt(p + ivec2( 0,  1));

    float dx = hR - hL;
    float dy = hU - hD;

    return normalize(vec3(
        -dx * NormalScale,
        -dy * NormalScale,
         1.0
    ));
}


void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(p, CanvasSize)))
        return;

    vec4 wet = imageLoad(uWetPaint, p);
    vec4 dry = imageLoad(uDryPaint, p);

    // Dry is the only visible paint source.
    float visibleDensity = max(dry.a, 0.0);
    float coverage = VisibleCoverageFromDensity(visibleDensity);

    // Wet affects only material state.
    float wetFactor = WetFactorFromDensity(wet.a);

    float roughness = mix(
        DryRoughness,
        WetRoughness,
        wetFactor
    );

    vec3 normal = ResolveNormal(p);
    vec3 encodedNormal = normal * 0.5 + 0.5;

    vec3 visibleColor = clamp(dry.rgb, vec3(0.0), vec3(1.0));

    imageStore(
        uResolvedColor,
        p,
        vec4(
            visibleColor,
            coverage
        )
    );

    imageStore(
        uResolvedRoughness,
        p,
        vec4(
            1.0,
            roughness,
            Metallic,
            coverage
        )
    );

    imageStore(
        uResolvedNormal,
        p,
        vec4(
            encodedNormal,
            coverage
        )
    );
}