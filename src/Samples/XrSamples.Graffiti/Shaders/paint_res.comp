#include "./uniforms_comp.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly uniform highp image2D uWetPaint;
layout(rgba16f, binding = 1) readonly uniform highp image2D uDryPaint;

// Base color texture.
// rgb = straight base color
// a   = coverage
layout(rgba16f, binding = 2) writeonly uniform highp image2D uResolvedColor;

// PBR ORM-like texture.
// r = roughness
// g = metallic
// b = unused
// a = coverage
layout(rgba16f, binding = 3) writeonly uniform highp image2D uResolvedRoughness;

// Normal map.
// rgb = encoded tangent-space normal
// a   = coverage
layout(rgba16f, binding = 4) writeonly uniform highp image2D uResolvedNormal;


float DensityAt(ivec2 p)
{
    p = clamp(p, ivec2(0), CanvasSize - ivec2(1));

    vec4 dry = imageLoad(uDryPaint, p);
    vec4 wet = imageLoad(uWetPaint, p);

    return dry.a + wet.a;
}

vec3 ResolveBaseColor(vec4 dry, vec4 wet)
{
    float totalDensity = dry.a + wet.a;

    if (totalDensity <= EPS)
        return vec3(0.0);

    if (wet.a <= EPS)
        return UnitColor(dry);

    vec3 pureDry = UnitColor(dry);
    vec3 pureWet = wet.rgb / wet.a;

    float wetCoverage = min(wet.a, 1.0);

    return
        pureDry * (1.0 - wetCoverage) +
        pureWet * wetCoverage;
}

float ResolveRoughness(vec4 dry, vec4 wet)
{
    float totalDensity = dry.a + wet.a;

    if (totalDensity <= EPS)
        return DryRoughness;

    float wetCoverage = clamp(wet.a, 0.0, 1.0);

    return mix(DryRoughness, WetRoughness, wetCoverage);
}

vec3 ResolveNormal(ivec2 p)
{
    float hL = DensityAt(p + ivec2(-1,  0)) * DensityToHeight;
    float hR = DensityAt(p + ivec2( 1,  0)) * DensityToHeight;
    float hD = DensityAt(p + ivec2( 0, -1)) * DensityToHeight;
    float hU = DensityAt(p + ivec2( 0,  1)) * DensityToHeight;

    float dx = hR - hL;
    float dy = hU - hD;

    return normalize(vec3(
        -dx * NormalScale,
        -dy * NormalScale,
         1.0
    ));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(p, CanvasSize)))
        return;

    vec4 dry = imageLoad(uDryPaint, p);
    vec4 wet = imageLoad(uWetPaint, p);

    float totalDensity = dry.a + wet.a;
    float coverage = CoverageFromDensity(totalDensity);

    vec3 baseColor = ResolveBaseColor(dry, wet);
    float roughness = ResolveRoughness(dry, wet);

    vec3 normal = ResolveNormal(p);
    vec3 encodedNormal = normal * 0.5 + 0.5;

    imageStore(
        uResolvedColor,
        p,
        vec4(baseColor, coverage)
    );

    imageStore(
        uResolvedRoughness,
        p,
        vec4(
            1.0,       // R unused, or AO only if your own pipeline uses ORM
            roughness, // G = roughness
            Metallic,  // B = metallic
            coverage   // A optional/custom
        )
    );

    imageStore(
        uResolvedNormal,
        p,
        vec4(encodedNormal, coverage)
    );
}