#include "./uniforms_comp.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform highp sampler2D uIncomingSpray;

layout(rgba16f, binding = 1) readonly  uniform highp image2DArray uPaintIn;
layout(rgba16f, binding = 2) writeonly uniform highp image2DArray uPaintOut;

vec4 AddSprayToLayer(vec4 oldPaint, float sprayDensity)
{
    if (sprayDensity <= 0.0)
        return oldPaint;

    float oldDensity = oldPaint.a;
    float newDensity = sprayDensity;
    float totalDensity = oldDensity + newDensity;

    if (totalDensity <= 0.000001)
        return vec4(0.0);

    vec4 physicalMixed =
        oldPaint + vec4(SprayColor * newDensity, newDensity);

    vec4 overrideMixed =
        vec4(SprayColor * totalDensity, totalDensity);

    float mixStrength =
        clamp(Layers[0].MixStrength * GlobalMixScale, 0.0, 1.0);

    return mix(overrideMixed, physicalMixed, mixStrength);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec3 size = imageSize(uPaintIn);

    if (p.x >= size.x || p.y >= size.y)
        return;

    vec4 before[MAX_PAINT_LAYERS];
    vec4 after[MAX_PAINT_LAYERS];

    for (int i = 0; i < MAX_PAINT_LAYERS; ++i)
    {
        before[i] =
            i < LayerCount
                ? imageLoad(uPaintIn, ivec3(p, i))
                : vec4(0.0);

        after[i] = before[i];
    }

    float sprayDensity =
        texelFetch(uIncomingSpray, p, 0).r * SprayDensityScale;

    if (LayerCount > 0)
    {
        after[0] = AddSprayToLayer(after[0], sprayDensity);
        before[0] = after[0];
    }

    for (int i = 0; i < MAX_PAINT_LAYERS - 1; ++i)
    {
        if (i >= LayerCount - 1)
            break;

        float density = before[i].a;

        if (density <= 0.000001)
            continue;

        float moveDensity =
            Layers[i].DryRateToNext *
            GlobalDryScale *
            DeltaTime;

        moveDensity = clamp(moveDensity, 0.0, density);

        float f = moveDensity / density;

        vec4 transfer = before[i] * f;

        after[i]     -= transfer;
        after[i + 1] += transfer;
    }

    for (int i = 0; i < MAX_PAINT_LAYERS; ++i)
    {
        if (i < LayerCount)
            imageStore(uPaintOut, ivec3(p, i), max(after[i], vec4(0.0)));
    }
}