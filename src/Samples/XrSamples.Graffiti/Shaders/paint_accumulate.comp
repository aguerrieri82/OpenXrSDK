#include "./uniforms_comp.glsl"

layout(local_size_x = 8, local_size_y = 8) in;


// Wet layer:
//   rgb = wetColor * wetDensity
//   a   = wetDensity
//
// Meaning unchanged:
//   wet accumulates additively.
//   wet.rgb is premultiplied by wet.a.
//   wetColor = wet.rgb / wet.a.
layout(rgba16f, binding = 1) readonly uniform highp image2D uWetPaint;
// Dry / visible layer:
//   rgb = visible resolved color
//   a   = accumulated visible density
layout(rgba16f, binding = 2) readonly uniform highp image2D uDryPaint;


layout(rgba16f, binding = 3) writeonly uniform highp image2D uWetPaintOut;
layout(rgba16f, binding = 4) writeonly uniform highp image2D uDryPaintOut;


// Incoming density texture.
// Only R is used.
layout(binding = 0) uniform highp sampler2D uIncomingDensity;


#ifndef INPUT_EPS
#define INPUT_EPS 0.0001
#endif

#ifndef WET_CLEAR_EPS
#define WET_CLEAR_EPS 0.0001
#endif


vec3 MixByDensity(
    vec3 oldColor,
    float oldDensity,
    vec3 newColor,
    float newDensity)
{
    float totalDensity = oldDensity + newDensity;

    if (totalDensity <= EPS)
        return newColor;

    return
        (oldColor * oldDensity + newColor * newDensity)
        / totalDensity;
}


// Composite the newly resolved wet contribution into the visible layer.
//
// Rules:
//
//   dry.a < 1, wet.a < 1:
//       mix proportionally by density
//
//   wet.a >= 1:
//       wet fully replaces visible color
//
//   dry.a >= 1, wet.a < 1:
//       wet covers dry proportionally to wet.a
//       example: wet.a = 0.5 -> 50% mix with dry
//
vec3 MixWetIntoDry(
    vec3 dryColor,
    float dryDensity,
    vec3 wetColor,
    float wetDensity)
{
    if (wetDensity >= 1.0)
        return wetColor;

    if (dryDensity < 1.0)
    {
        return MixByDensity(
            dryColor,
            dryDensity,
            wetColor,
            wetDensity
        );
    }

    return mix(
        dryColor,
        wetColor,
        clamp(wetDensity, 0.0, 1.0)
    );
}


void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(p, CanvasSize)))
        return;

    vec4 wet = imageLoad(uWetPaint, p);
    vec4 dry = imageLoad(uDryPaint, p);

    // ------------------------------------------------------------
    // 1) Incoming spray.
    //
    // Wet still accumulates like before:
    //
    //   wet.rgb += incomingColor * incomingDensity
    //   wet.a   += incomingDensity
    //
    // Then the newly incoming amount is immediately resolved into
    // the dry/visible layer using the current mixed wet color.
    // ------------------------------------------------------------

    float incomingDensity =
        texelFetch(uIncomingDensity, p, 0).r * PaintColor.a;

    if (incomingDensity > INPUT_EPS)
    {
        vec3 incomingColor = clamp(PaintColor.rgb, vec3(0.0), vec3(1.0));

        // Old wet accumulation behavior.
        wet.rgb += incomingColor * incomingDensity;
        wet.a   += incomingDensity;

        // Current mixed wet color after additive accumulation.
        vec3 mixedWetColor = wet.rgb / wet.a;

        // Only the newly incoming amount is transferred immediately
        // into the visible layer.
        dry.rgb = MixWetIntoDry(
            dry.rgb,
            dry.a,
            mixedWetColor,
            incomingDensity
        );

        // Dry density still accumulates total deposited material.
        dry.a += incomingDensity;
    }

    // ------------------------------------------------------------
    // 2) Drying.
    //
    // Drying affects only the wet temporary state.
    // It does not modify dry.rgb or dry.a.
    // ------------------------------------------------------------

    if (wet.a > EPS)
    {
        vec3 wetColor = wet.rgb / wet.a;

        float deltaD = min(wet.a, DryRate * DeltaTime);

        wet.a -= deltaD;

        if (wet.a > WET_CLEAR_EPS)
            wet.rgb = wetColor * wet.a;
        else
            wet = vec4(0.0);
    }
    else
    {
        wet = vec4(0.0);
    }

    // ------------------------------------------------------------
    // 3) Clamp sane storage.
    // ------------------------------------------------------------

    dry.rgb = clamp(dry.rgb, vec3(0.0), vec3(1.0));
    dry.a   = max(dry.a, 0.0);

    if (wet.a > EPS)
    {
        vec3 wetColor = clamp(wet.rgb / wet.a, vec3(0.0), vec3(1.0));
        wet.rgb = wetColor * wet.a;
        wet.a = max(wet.a, 0.0);
    }
    else
    {
        wet = vec4(0.0);
    }

    imageStore(uWetPaintOut, p, wet);
    imageStore(uDryPaintOut, p, dry);
}