<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(CoreVersion);$(CoreVersion)-android</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup Condition="'$(OpenGL)' == 'ES'">
		<PackageReference Include="Silk.NET.OpenGLES" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenGLES.Extensions.EXT" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenGLES.Extensions.QCOM" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(OpenGL)' == ''">
		<PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Silk.NET.OpenGL.Extensions.ARB" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenGL.Extensions.EXT" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\XrEngine.Compression\XrEngine.Compression.csproj" />
		<ProjectReference Include="..\XrEngine.Core\XrEngine.Core.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([System.String]::Copy('$(DefineConstants)').Contains('GL_WRAPPER'))">
		<Using Include="OpenGLWrapper.IGLWrapper" Alias="GL" />
		<Using Include="OpenGLWrapper" />
		<ProjectReference Include="..\..\Framework\OpenGLWrapper\OpenGLWrapper.csproj" />
	</ItemGroup>
</Project>
