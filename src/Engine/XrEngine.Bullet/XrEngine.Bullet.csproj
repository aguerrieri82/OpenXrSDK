<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(CoreVersion);$(CoreVersion)-android</TargetFrameworks>
		<NativeFolder>Release</NativeFolder>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsAndroid)' == 'false' AND '$(BulletLink)' != 'PreBuilt'">
		<Content PackagePath="runtimes/win-x64/native/" 
			Include="..\XrEngine.Bullet.Native\bin\$(NativePlatform)\$(NativeFolder)\*" 
			CopyToOutputDirectory="PreserveNewest" 
			UseLink="True"
			Visible="False"
			Link="%(Filename)%(Extension)" />	
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\XrEngine.Core\XrEngine.Core.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsPacking)' != 'true'">
		<ProjectReference Include="..\XrEngine.Bullet.Native\XrEngine.Bullet.Native.vcxproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsAndroid)' == 'true'">
		<AndroidNativeLibrary Abi="arm64-v8a" Include="$(NativeLibsDir)bullet3-native\android-arm64\*.so" />
	</ItemGroup>

</Project>
