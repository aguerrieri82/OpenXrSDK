layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#ifndef FORMAT
    #define FORMAT rgba16f
#endif

#ifndef MIP_LEVEL
    #define MIP_LEVEL 0
#endif

#ifdef USE_ARRAY
    layout(FORMAT, binding = 0) readonly highp uniform image2DArray uIn;
    layout(FORMAT, binding = 1) writeonly highp uniform image2DArray uOut;
#else
    layout(FORMAT, binding = 0) readonly highp uniform image2D uIn;
    layout(FORMAT, binding = 1) writeonly highp uniform image2D uOut;
#endif

uniform int   uRadius;
uniform float uWeights[64];

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

#ifdef USE_ARRAY
    int layer = int(gl_GlobalInvocationID.z);
    ivec3 ip = ivec3(p, layer);
    ivec3 sz = imageSize(uIn);

    if (p.x >= sz.x || p.y >= sz.y || layer >= sz.z) return;
#else
    ivec2 sz = imageSize(uIn);

    if (p.x >= sz.x || p.y >= sz.y) return;
#endif

#if CHANNELS == 2
    vec2 acc = vec2(0.0);
#elif CHANNELS == 3
    vec3 acc = vec3(0.0);
#else
    float acc = 0.0;
#endif

#ifdef USE_ARRAY
    #if CHANNELS == 2
        vec2 c = imageLoad(uIn, ip).rg;
    #elif CHANNELS == 3
        vec3 c = imageLoad(uIn, ip).rgb;
    #else
        float c = imageLoad(uIn, ip).r;
    #endif
#else
    #if CHANNELS == 2
        vec2 c = imageLoad(uIn, p).rg;
    #elif CHANNELS == 3
        vec3 c = imageLoad(uIn, p).rgb;
    #else
        float c = imageLoad(uIn, p).r;
    #endif
#endif

    acc += c * uWeights[0];

    for (int i = 1; i <= uRadius; ++i)
    {
        int x0 = clamp(p.x - i, 0, sz.x - 1);
        int x1 = clamp(p.x + i, 0, sz.x - 1);

#ifdef USE_ARRAY
        #if CHANNELS == 2
            vec2 a = imageLoad(uIn, ivec3(x0, p.y, layer)).rg;
            vec2 b = imageLoad(uIn, ivec3(x1, p.y, layer)).rg;
        #elif CHANNELS == 3
            vec3 a = imageLoad(uIn, ivec3(x0, p.y, layer)).rgb;
            vec3 b = imageLoad(uIn, ivec3(x1, p.y, layer)).rgb;
        #else
            float a = imageLoad(uIn, ivec3(x0, p.y, layer)).r;
            float b = imageLoad(uIn, ivec3(x1, p.y, layer)).r;
        #endif
#else
        #if CHANNELS == 2
            vec2 a = imageLoad(uIn, ivec2(x0, p.y)).rg;
            vec2 b = imageLoad(uIn, ivec2(x1, p.y)).rg;
        #elif CHANNELS == 3
            vec3 a = imageLoad(uIn, ivec2(x0, p.y)).rgb;
            vec3 b = imageLoad(uIn, ivec2(x1, p.y)).rgb;
        #else
            float a = imageLoad(uIn, ivec2(x0, p.y)).r;
            float b = imageLoad(uIn, ivec2(x1, p.y)).r;
        #endif
#endif

        float w = uWeights[i];
        acc += (a + b) * w;
    }

#ifdef USE_ARRAY
    #if CHANNELS == 3
        imageStore(uOut, ip, vec4(acc, 1.0));
    #elif CHANNELS == 2
        imageStore(uOut, ip, vec4(acc, 1.0, 1.0));
    #else
        imageStore(uOut, ip, vec4(acc));
    #endif
#else
    #if CHANNELS == 3
        imageStore(uOut, p, vec4(acc, 1.0));
    #elif CHANNELS == 2
        imageStore(uOut, p, vec4(acc, 1.0, 1.0));
    #else
        imageStore(uOut, p, vec4(acc));
    #endif
#endif
}